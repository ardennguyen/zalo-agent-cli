# ============================================================================
# zalo-agent-cli — Environment Configuration Template (.env.example)
# ============================================================================
# Copy this file to `.env` in your working directory or `~/.zalo-agent-cli/.env`,
# or pass `--env-file /path/to/.env` (or `ZALO_ENV_FILE=/path/to/.env`).
# CLI flags and shell environment variables take precedence over `.env` values.

# ----------------------------------------------------------------------------
# Storage Directories (Optional)
# Uncomment to separate config, credentials, SQLite database, and media onto
# different volumes or mounts in production:
# ----------------------------------------------------------------------------
# ZALO_CONFIG_DIR=
# ZALO_CREDENTIALS_DIR=
# ZALO_DATA_DIR=
# ZALO_MEDIA_DIR=
# ZALO_OA_DIR=

# ----------------------------------------------------------------------------
# Runtime & Protocol Options (Optional)
# ----------------------------------------------------------------------------
# Set to any value (e.g. 1) to disable the background npm update check:
# ZALO_AGENT_NO_UPDATE_CHECK=1

# Protocol version announced to Zalo (default: 691; set 685 to roll back):
# ZALO_API_VERSION=691
