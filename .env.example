# ============================================================================
# zalo-agent-cli — Environment Configuration Template (.env.example)
# ============================================================================
# Recommended location: `~/.zalo-agent-cli/.env` (`<CONFIG_DIR>/.env`), or pass
# `--env-file /path/to/.env` (`ZALO_ENV_FILE=/path/to/.env`).
# Note: If you also use the `zalo-mcp` deployment wrapper, keep `zalo-mcp/.env`
# for port settings (`ZALO_MCP_HTTP_PORT`, `ZALO_OA_WEBHOOK_PORT`) only, and put
# all storage paths and engine settings in `<CONFIG_DIR>/.env` so `zalo-mcp` and
# `zalo-agent` share a single source of truth.
# CLI flags and shell environment variables take precedence over `.env` values.

# ----------------------------------------------------------------------------
# Storage Directories (Optional)
# Uncomment to separate config, credentials, SQLite database, and media onto
# different volumes or mounts in production:
# ----------------------------------------------------------------------------
# ZALO_CONFIG_DIR=
# ZALO_CREDENTIALS_DIR=
# ZALO_DATA_DIR=
# ZALO_MEDIA_DIR=
# ZALO_OA_DIR=

# ----------------------------------------------------------------------------
# Runtime & Account Options (Optional)
# ----------------------------------------------------------------------------
# Pin a default registered account ID for this environment without changing
# the global active entry in accounts.json (equivalent to --account <ID>):
# ZALO_ACCOUNT=

# Set to any value (e.g. 1) to disable the background npm update check:
# ZALO_AGENT_NO_UPDATE_CHECK=1

# Protocol version announced to Zalo (default: 691; set 685 to roll back):
# ZALO_API_VERSION=691

