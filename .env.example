# ============================================================================
# zalo-agent-cli — Environment Configuration Template (.env.example)
# ============================================================================
# Recommended location: `~/.zalo-agent-cli/.env` (`<CONFIG_DIR>/.env`), or pass
# `--env-file /path/to/.env` (`ZALO_ENV_FILE=/path/to/.env`).
# Note: If you also use the `zalo-mcp` deployment wrapper, keep `zalo-mcp/.env`
# for the port (`ZALO_MCP_HTTP_PORT`) only, and put
# all storage paths and engine settings in `<CONFIG_DIR>/.env` so `zalo-mcp` and
# `zalo-agent` share a single source of truth.
# CLI flags and shell environment variables take precedence over `.env` values.

# ----------------------------------------------------------------------------
# Storage Directories (Optional)
# Uncomment to separate config, credentials, SQLite database, and media onto
# different volumes or mounts in production:
# ----------------------------------------------------------------------------
# ZALO_CONFIG_DIR=
# ZALO_CREDENTIALS_DIR=
# ZALO_DATA_DIR=
# ZALO_MEDIA_DIR=
# ZALO_OA_DIR=

# ----------------------------------------------------------------------------
# Runtime & Account Options (Optional)
# ----------------------------------------------------------------------------
# Pin a default registered account ID for this environment without changing
# the global active entry in accounts.json (equivalent to --account <ID>):
# ZALO_ACCOUNT=

# Set to any value (e.g. 1) to disable the background npm update check:
# ZALO_AGENT_NO_UPDATE_CHECK=1

# Protocol version announced to Zalo (default: 694; set 685 to roll back):
# ZALO_API_VERSION=694

# Which QR login `login` uses: official (default, the sequence Zalo Web makes) or legacy (zca-js's own):
# ZALO_QR_FLOW=official

# ----------------------------------------------------------------------------
# MCP server / CRM backend (`zalo-agent mcp start`; all optional)
# Ready-to-copy files for local, LAN, internet, CRM and many-account setups:
# docs/configuration.md and docs/config-samples/. Every name below also takes a
# per-account form, e.g. ZALO_MCP_HTTP_PORT_<ownId>, which beats the plain name.
# Put secrets here (file mode 0600), never on the command line: a flag shows in `ps`.
# ----------------------------------------------------------------------------
# ZALO_MCP_HTTP_PORT=3847                 # serve HTTP instead of stdio
# ZALO_MCP_HOST=127.0.0.1                 # bind address; never 0.0.0.0 without a token
# ZALO_MCP_AUTH_TOKEN=                    # bearer token: openssl rand -hex 32
# ZALO_WEBHOOK_URL=                       # POST each incoming message here
# ZALO_WEBHOOK_SECRET=                    # signs it (X-Zalo-Signature: sha256=...)
# ZALO_WEBHOOK_BATCH_SIZE=1               # events per POST (1-100); the webhook retries and survives restarts
# ZALO_WEBHOOK_MAX_AGE=24h                # an undelivered event older than this is dead-lettered
# ZALO_LOG_LEVEL=info                     # daemon.log: error | warn | info | debug (debug adds a line per request and message)
# ZALO_LOG_FORMAT=text                    # or json (one object per line)
# ZALO_LOG_MAX_SIZE=50m                   # rotate daemon.log at this size ...
# ZALO_LOG_KEEP=3                         # ... keeping this many files
# ZALO_START_JITTER=0                     # seconds: wait 0-N s before logging in (a fleet restarting together)
# ZALO_LOGIN_SLOTS=0                      # at most N daemons on the machine logging in at once; 0 = no cap
# ZALO_SEND_FORMAT=plain                  # markdown | plain: how text messages are sent (the MCP tool defaults to markdown)

