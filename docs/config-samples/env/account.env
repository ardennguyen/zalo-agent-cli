# ============================================================================
# /etc/zalo-mcp/accounts/<ownId>.env      (one file per account)
# Used by the systemd template ../systemd/zalo-mcp@.service: the instance name
# is the account id, so zalo-mcp@1000000000000000001 reads
# /etc/zalo-mcp/accounts/1000000000000000001.env
# ============================================================================
#   sudo install -m 600 -o zalo -g zalo account.env /etc/zalo-mcp/accounts/1000000000000000001.env

ZALO_MCP_HOST=127.0.0.1
ZALO_MCP_HTTP_PORT=3901
ZALO_MCP_AUTH_TOKEN=CHANGE_ME_64_HEX_CHARACTERS
ZALO_WEBHOOK_URL=https://crm.example.com/hooks/zalo/shop-a
ZALO_WEBHOOK_SECRET=CHANGE_ME_WEBHOOK_SIGNING_SECRET

# This account's own proxy is set at login (`zalo-agent login --proxy ...`),
# not here. Use one proxy per account.
