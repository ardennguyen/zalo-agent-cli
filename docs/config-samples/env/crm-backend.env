# ============================================================================
# /etc/zalo-mcp/crm.env      (systemd EnvironmentFile)
# One account as a backend for a CRM: webhook push, MCP over HTTP for sends
# ============================================================================
#   sudo install -m 600 -o zalo -g zalo crm.env /etc/zalo-mcp/crm.env
#   zalo-agent --env-file /etc/zalo-mcp/crm.env mcp start --account 1000000000000000001

ZALO_MCP_HOST=127.0.0.1
ZALO_MCP_HTTP_PORT=3847
# The CRM calls the MCP endpoint (POST /mcp) with this bearer token:
ZALO_MCP_AUTH_TOKEN=CHANGE_ME_64_HEX_CHARACTERS

# Where each incoming message is POSTed, and the secret that signs it:
# `Authorization: Bearer <secret>` plus `X-Zalo-Signature: sha256=<hmac of the body>`.
# Delivery is durable: every event is queued on disk and sent in order, at least
# once, retried (1 s doubling to 5 min) while the CRM is down or slow (a POST has
# 10 seconds). The CRM verifies the signature, answers 2xx at once and de-duplicates
# on the message id. Backlog: `zalo-agent mcp webhook status`.
ZALO_WEBHOOK_URL=https://crm.example.com/hooks/zalo
ZALO_WEBHOOK_SECRET=CHANGE_ME_WEBHOOK_SIGNING_SECRET
# Several events per POST as {event:"batch", events:[...]} (1-100; 1 = one each),
# and how long an undelivered event is retried before it is dead-lettered:
# ZALO_WEBHOOK_BATCH_SIZE=1
# ZALO_WEBHOOK_MAX_AGE=24h

# Destructive tool actions need `confirm: true` from the caller. A backend that
# decides for itself can set `off` (zalo_write still needs confirm):
ZALO_MCP_CONFIRM_MODE=agent
# Hidden chats stay hidden from the agent unless the owner opts in (exclude,
# contentless = an event with no thread id or content, include):
ZALO_MCP_HIDDEN_CHATS=exclude
# Never let the agent pass the hidden-chat PIN as a tool input (it would land in
# the client's logs); the owner types it on the one-time secure page instead:
ZALO_MCP_ALLOW_PIN_ARGUMENT=false
# The one public address of this server, through your reverse proxy / TLS
# terminator: the MCP endpoint, the OAuth issuer, and the links to the one-time
# secure page (/zalo/secure/<token>) and QR login page (/zalo/qr/<token>). https
# (http only for localhost); an optional base path. Unset, links use the
# server's own address.
ZALO_MCP_PUBLIC_URL=https://zalo.crm.example.com
# Approve and PIN pages go to the CRM, not the agent: the link is POSTed to the
# webhook above as {event:"approval_requested", accountId, kind, action, wouldDo,
# target, secureUrl, expiresAt, approverSecret} (signed like a message event), and
# the tool result carries only {approvalPending:true, ticket, deliveredTo:"webhook"}.
# The CRM shows the link to a person, then repeats the call with that ticket.
ZALO_MCP_APPROVAL_DELIVER=webhook
# ZALO_MCP_APPROVAL_SECRET picks what an approve page asks besides a click: auto
# (the default: the approver password when one is set with `zalo-agent mcp
# approver set`), pin (the hidden-chat PIN), password, or none.
