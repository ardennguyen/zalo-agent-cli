# ============================================================================
# /etc/zalo-mcp/crm.env      (systemd EnvironmentFile)
# One account as a backend for a CRM: webhook push, MCP over HTTP for sends
# ============================================================================
#   sudo install -m 600 -o zalo -g zalo crm.env /etc/zalo-mcp/crm.env
#   zalo-agent --env-file /etc/zalo-mcp/crm.env mcp start --account 1000000000000000001

ZALO_MCP_HOST=127.0.0.1
ZALO_MCP_HTTP_PORT=3847
# The CRM calls the MCP endpoint (POST /mcp) with this bearer token:
ZALO_MCP_AUTH_TOKEN=CHANGE_ME_64_HEX_CHARACTERS

# Where each incoming message is POSTed, and the secret that signs it:
# `Authorization: Bearer <secret>` plus `X-Zalo-Signature: sha256=<hmac of the body>`.
# Delivery is durable: every event is queued on disk and sent in order, at least
# once, retried (1 s doubling to 5 min) while the CRM is down or slow (a POST has
# 10 seconds). The CRM verifies the signature, answers 2xx at once and de-duplicates
# on the message id. Backlog: `zalo-agent mcp webhook status`.
ZALO_WEBHOOK_URL=https://crm.example.com/hooks/zalo
ZALO_WEBHOOK_SECRET=CHANGE_ME_WEBHOOK_SIGNING_SECRET
# Several events per POST as {event:"batch", events:[...]} (1-100; 1 = one each),
# and how long an undelivered event is retried before it is dead-lettered:
# ZALO_WEBHOOK_BATCH_SIZE=1
# ZALO_WEBHOOK_MAX_AGE=24h

# The backend decides for itself, so irreversible group tools need no `confirm`:
ZALO_MCP_GROUP_CONFIRM=0
