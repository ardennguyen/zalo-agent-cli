# ============================================================================
# /etc/zalo-mcp/internet.env  (systemd EnvironmentFile)
# MCP server reachable from the internet through a TLS reverse proxy
# ============================================================================
#   sudo install -m 600 -o zalo -g zalo internet.env /etc/zalo-mcp/internet.env
#
# The engine stays on loopback; Caddy or nginx terminates TLS on 443 and
# forwards to it (see ../proxy/). Never expose the engine's own port.

ZALO_MCP_HOST=127.0.0.1
ZALO_MCP_HTTP_PORT=3847

# A bearer token for scripts and backends:   openssl rand -hex 32
ZALO_MCP_AUTH_TOKEN=CHANGE_ME_64_HEX_CHARACTERS

# The PUBLIC https address clients and browsers reach: the MCP endpoint, the
# OAuth issuer, and the links to the one-time secure and QR pages. Without it
# links use the server's own address and the OAuth metadata advertises the
# address of the request it arrived on. (ZALO_MCP_ISSUER_URL is its deprecated
# 2.x name and still works.)
ZALO_MCP_PUBLIC_URL=https://zalo.example.com
# Cached media (zalo_view_media): pictures and voice inline, video and files as
# a link (<publicUrl>/zalo/media/<token>, 10 minutes). A link needs this server's
# bearer token as well (bearer); the proxy in front runs on this machine, so its
# X-Forwarded-For is believed for the per-client limits.
# ZALO_MCP_MEDIA_DELIVER=photo=inline,voice=inline,video=link,file=link
ZALO_MCP_MEDIA_LINK_AUTH=bearer
ZALO_MCP_TRUSTED_PROXIES=127.0.0.1

# OAuth 2.0 for remote connectors (claude.ai custom connector, ChatGPT, ...).
ZALO_MCP_OAUTH_CLIENT_ID=zalo-connector
ZALO_MCP_OAUTH_CLIENT_SECRET=CHANGE_ME_ANOTHER_64_HEX_CHARACTERS
# More than one consumer (each its own id and secret) goes in mcp-config.json
# under oauth.clients[].

# Native HTTPS instead of a proxy (not recommended: the engine then also tries
# to listen on 443). Both lines or neither:
# ZALO_MCP_TLS_CERT=/etc/letsencrypt/live/zalo.example.com/fullchain.pem
# ZALO_MCP_TLS_KEY=/etc/letsencrypt/live/zalo.example.com/privkey.pem
