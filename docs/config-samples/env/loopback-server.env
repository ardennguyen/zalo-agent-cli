# ============================================================================
# loopback-server.env      (`--env-file`, or the service's environment)
# MCP server over HTTP for AI clients on THIS machine only (Claude Code, an
# agent framework, a script): nothing on the network can reach it.
# ============================================================================
#   chmod 600 loopback-server.env
#
# Start:  zalo-agent --env-file loopback-server.env mcp start --account 1000000000000000001 -d
# Stop:   zalo-agent mcp start --account 1000000000000000001 --stop

ZALO_MCP_HOST=127.0.0.1
ZALO_MCP_HTTP_PORT=3847

# Still required: every process of every user on this machine can reach a
# loopback port. Generate one:  openssl rand -hex 32
ZALO_MCP_AUTH_TOKEN=CHANGE_ME_64_HEX_CHARACTERS

# Presence: on-demand closes the Zalo socket after 5 idle minutes and opens it
# again on the next tool call; always-on keeps it (real-time webhooks).
ZALO_PRESENCE_MODE=on-demand
ZALO_PRESENCE_IDLE_TIMEOUT=5m
