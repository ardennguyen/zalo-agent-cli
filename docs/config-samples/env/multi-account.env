# ============================================================================
# Per-account settings in ONE env file: every variable also exists as
# NAME_<ownId>, which beats the plain NAME for that account only.
# ============================================================================
# Handy for a few accounts. For many, give each account its own env file and
# its own systemd instance (account.env and ../systemd/zalo-mcp@.service).
#
# Precedence for an account, highest first:
#   command-line flag > NAME_<ownId> > NAME > mcp-config.json (accounts[<ownId>], then the file) > default

ZALO_MCP_HOST=127.0.0.1
ZALO_WEBHOOK_SECRET=CHANGE_ME_SHARED_WEBHOOK_SECRET

# Account 1000000000000000001
ZALO_MCP_HTTP_PORT_1000000000000000001=3901
ZALO_MCP_AUTH_TOKEN_1000000000000000001=CHANGE_ME_TOKEN_FOR_SHOP_A
ZALO_WEBHOOK_URL_1000000000000000001=https://crm.example.com/hooks/zalo/shop-a

# Account 1000000000000000002
ZALO_MCP_HTTP_PORT_1000000000000000002=3902
ZALO_MCP_AUTH_TOKEN_1000000000000000002=CHANGE_ME_TOKEN_FOR_SHOP_B
ZALO_WEBHOOK_URL_1000000000000000002=https://crm.example.com/hooks/zalo/shop-b
ZALO_WEBHOOK_SECRET_1000000000000000002=CHANGE_ME_OWN_WEBHOOK_SECRET_FOR_SHOP_B

# On-demand presence for every account, one account kept always-on (real-time webhooks).
ZALO_PRESENCE_MODE=on-demand
ZALO_PRESENCE_MODE_1000000000000000001=always-on
ZALO_PRESENCE_IDLE_TIMEOUT=5m

# The fleet controller (zalo-agent fleet serve): its port, how it drives the daemons (systemd units
# through the polkit rule, or spawned processes), and the admin webhook it mirrors account_state to.
ZALO_FLEET_CONTROLLER_PORT=3899
ZALO_FLEET_SUPERVISOR=spawn
# ZALO_FLEET_WEBHOOK=https://crm.example.com/hooks/zalo/fleet
# ZALO_FLEET_WEBHOOK_SECRET=CHANGE_ME_FLEET_WEBHOOK_SECRET
