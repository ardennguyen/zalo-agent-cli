# ============================================================================
# zalo-mcp/.env              (the deployment folder of the zalo-mcp wrapper)
# ============================================================================
# The wrapper's launcher loads this file before it starts the engine, so what
# is here reaches `zalo-agent mcp start`. Keep it to PORTS. Storage paths,
# tokens and webhook settings belong in <CONFIG_DIR>/.env (config-dir.env) or
# a per-service env file, so `zalo-mcp` and `zalo-agent` read one source.

# The HTTP port `zalo-mcp --http` uses when no port is given (default 3847):
ZALO_MCP_HTTP_PORT=3847

# NOTE: `oa listen` takes its port from `--port` (default 3000). The engine
# does not read ZALO_OA_WEBHOOK_PORT, even though older copies of this file
# listed it.
