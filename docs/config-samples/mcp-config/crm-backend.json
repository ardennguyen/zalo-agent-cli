{
    "watchThreads": ["dm:*"],
    "host": "127.0.0.1",
    "httpPort": 3847,
    "webhook": "https://crm.example.com/hooks/zalo",
    "webhookSecret": null,
    "limits": {
        "maxMessagesPerPoll": 50,
        "bufferMaxAge": "6h",
        "bufferMaxSize": 2000
    },
    "media": {
        "downloadDir": "/var/lib/zalo-media",
        "autoOpen": false,
        "deliver": {"photo": "inline", "gif": "inline", "doodle": "inline", "sticker": "inline", "voice": "inline", "audio": "inline", "video": "link", "file": "link"},
        "inlineMaxBytes": 5242880,
        "allowDeliver": ["inline", "link"],
        "linkTtl": "10m",
        "tempfileTtl": "10m",
        "linkAuth": "bearer",
        "linkRateLimit": 60,
        "capability": { "maxClients": 3, "ttl": "15m" }
    },
    "notify": {
        "enabled": false,
        "thread": null,
        "on": ["dm"],
        "cooldown": "5m"
    },
    "confirmMode": "agent",
    "hiddenChats": "exclude",
    "allowPinArgument": false,
    "trustedProxies": ["127.0.0.1"],
    "publicUrl": "https://zalo.crm.example.com",
    "approval": {
        "secret": "auto",
        "deliver": "webhook"
    }
}
