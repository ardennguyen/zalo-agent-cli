{
    "watchThreads": ["dm:*"],
    "host": "127.0.0.1",
    "httpPort": 3847,
    "webhook": "https://crm.example.com/hooks/zalo",
    "webhookSecret": null,
    "limits": {
        "maxMessagesPerPoll": 50,
        "bufferMaxAge": "6h",
        "bufferMaxSize": 2000
    },
    "media": {
        "downloadDir": "/var/lib/zalo-media",
        "autoOpen": false
    },
    "notify": {
        "enabled": false,
        "thread": null,
        "on": ["dm"],
        "cooldown": "5m"
    },
    "confirmMode": "agent",
    "hiddenChats": "exclude",
    "allowPinArgument": false,
    "pinPage": {
        "publicBaseUrl": "https://zalo.crm.example.com"
    }
}
