{
    "watchThreads": ["dm:*", "group:*"],
    "host": "127.0.0.1",
    "httpPort": 3847,
    "oauth": {
        "clientId": "zalo-connector",
        "clientSecret": null,
        "clients": []
    },
    "limits": {
        "maxMessagesPerPoll": 20,
        "bufferMaxAge": "2h",
        "bufferMaxSize": 500
    },
    "media": {
        "downloadDir": null,
        "autoOpen": false,
        "deliver": {"photo": "inline", "gif": "inline", "doodle": "inline", "sticker": "inline", "voice": "inline", "audio": "inline", "video": "link", "file": "link"},
        "inlineMaxBytes": 5242880,
        "allowDeliver": ["inline", "link"],
        "linkTtl": "10m",
        "tempfileTtl": "10m",
        "linkAuth": "bearer",
        "linkRateLimit": 60,
        "capability": { "maxClients": 3, "ttl": "15m" }
    },
    "confirmMode": "agent",
    "hiddenChats": "exclude",
    "allowPinArgument": false,
    "trustedProxies": ["127.0.0.1"],
    "publicUrl": "https://zalo.example.com",
    "approval": {
        "secret": "auto",
        "deliver": "result"
    }
}
