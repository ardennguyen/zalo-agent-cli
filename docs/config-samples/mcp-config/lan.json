{
    "watchThreads": ["dm:*", "group:*"],
    "triggerKeywords": ["@bot"],
    "host": "192.168.1.20",
    "httpPort": 3847,
    "limits": {
        "bufferMaxAge": "2h",
        "bufferMaxSize": 500
    },
    "media": {
        "downloadDir": null,
        "autoOpen": false,
        "deliver": {"photo": "inline", "gif": "inline", "doodle": "inline", "sticker": "inline", "voice": "inline", "audio": "inline", "video": "link", "file": "link"},
        "inlineMaxBytes": 5242880,
        "allowDeliver": ["inline", "link", "tempfile"],
        "linkTtl": "10m",
        "tempfileTtl": "10m",
        "linkAuth": "auto",
        "linkRateLimit": 60,
        "capability": { "maxClients": 3, "ttl": "15m" }
    },
    "confirmMode": "agent",
    "hiddenChats": "exclude",
    "allowPinArgument": false,
    "publicUrl": null,
    "approval": {
        "secret": "auto",
        "deliver": "result"
    },
    "admin": {
        "tokenFile": null,
        "clientCa": null
    },
    "presence": {
        "mode": "on-demand",
        "idleTimeout": "5m",
        "minConnected": "60s",
        "maxWakesPerHour": 12,
        "warmWait": "10s",
        "connectOnStart": true,
        "catchUpEvery": "off",
        "maxLeases": 64,
        "leaseTtl": "90s",
        "leaseTtlMax": "600s",
        "waitHoldsSocket": true,
        "onKick": "yield"
    }
}
