{
    "watchThreads": ["dm:*", "group:*"],
    "triggerKeywords": ["@bot"],
    "limits": {
        "maxMessagesPerPoll": 20,
        "autoDigestThreshold": 50,
        "bufferMaxAge": "2h",
        "bufferMaxSize": 500
    },
    "media": {
        "downloadDir": null,
        "autoOpen": true
    },
    "notify": {
        "enabled": false,
        "thread": null,
        "on": ["dm"],
        "cooldown": "5m"
    },
    "groupConfirm": true
}
