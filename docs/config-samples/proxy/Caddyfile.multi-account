# Caddyfile: several accounts behind one hostname, one path prefix per account.
# Each account is its own zalo-mcp@<id> instance on its own loopback port
# (../env/account.env: ZALO_MCP_HTTP_PORT). Bearer-token auth per account;
# OAuth issuer URLs are awkward behind a path prefix, so use tokens here.
zalo.example.com {
	encode zstd gzip

	handle_path /a/1000000000000000001/* {
		reverse_proxy 127.0.0.1:3901 {
			flush_interval -1
			transport http {
				read_timeout 310s
			}
		}
	}

	handle_path /a/1000000000000000002/* {
		reverse_proxy 127.0.0.1:3902 {
			flush_interval -1
			transport http {
				read_timeout 310s
			}
		}
	}

	# A client for account 1 talks to  https://zalo.example.com/a/1000000000000000001/mcp
	# and  https://zalo.example.com/a/1000000000000000001/events/wait
	respond 404
}
