# /etc/zalo-mcp/common.env        read by every zalo-mcp@<id> instance
#   sudo install -m 600 -o zalo -g zalo common.env /etc/zalo-mcp/common.env
# Per-account settings go in /etc/zalo-mcp/accounts/<id>.env, which is read after this file.

ZALO_MCP_HOST=127.0.0.1
ZALO_MCP_GROUP_CONFIRM=0
ZALO_DATA_DIR=/var/lib/zalo-agent/accounts
ZALO_MEDIA_DIR=/var/lib/zalo-media

# daemon.log: `info` leaves out the line per HTTP request and per message that `debug` adds, and
# rotates at 50 MB keeping 3 files. JSON lines suit a log shipper.
# ZALO_LOG_LEVEL=info
# ZALO_LOG_FORMAT=json
# ZALO_LOG_MAX_SIZE=50m
# ZALO_LOG_KEEP=3

# A fleet restarting together is the heaviest moment of each daemon's life (every start logs in and
# loads the friend and group lists). The unit already sleeps a random 0-30 s before starting; these two
# do the same inside the daemon, for any supervisor: wait up to this long before logging in, and let at
# most this many daemons on the machine be logging in at once (the rest wait for a slot).
# ZALO_START_JITTER=30
# ZALO_LOGIN_SLOTS=3
