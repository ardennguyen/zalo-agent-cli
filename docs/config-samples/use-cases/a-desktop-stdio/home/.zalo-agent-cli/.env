# ============================================================================
# <CONFIG_DIR>/.env          (default: ~/.zalo-agent-cli/.env)
# ============================================================================
# Read by EVERY zalo-agent / zalo-mcp command on this machine, whatever the
# working directory. This is the one place for per-machine settings: where
# data lives, and settings that belong to no single process.
#
#   chmod 600 ~/.zalo-agent-cli/.env      # it can hold secrets
#
# A real environment variable, or a CLI flag, always beats a line here.
# The wrapper's own zalo-mcp/.env is for PORTS only: see wrapper-folder.env.

# --- Where data lives (all optional; the defaults are under CONFIG_DIR) -------
# Put the SQLite caches and media on a bigger or faster disk:
# ZALO_DATA_DIR=/var/lib/zalo-agent/accounts
# ZALO_MEDIA_DIR=/var/lib/zalo-agent/media
# Keep credentials on a small, locked-down volume:
# ZALO_CREDENTIALS_DIR=/etc/zalo-agent/credentials
# Official Account credentials (default: ~/.zalo-agent):
# ZALO_OA_DIR=/etc/zalo-agent/oa

# --- Behavior -----------------------------------------------------------------
# A server should not shell out to npm to look for updates on every command:
ZALO_AGENT_NO_UPDATE_CHECK=1
# Who confirms a destructive MCP tool action (recall, delete, leave a group, ...):
# `agent` (the caller sends confirm: true), `human` (the server asks the user
# through MCP elicitation), `off` (no question; zalo_write still needs confirm).
# Wins over `confirmMode` in mcp-config.json. Keep `agent` for an AI agent:
ZALO_MCP_CONFIRM_MODE=agent
# Opt-in cap on the non-friend DM names one sync restore looks up (unset = all,
# in requests of 500 as Zalo does; a 221 refusal parks them for an hour):
# ZALO_SYNC_NAME_REFRESH_MAX=
