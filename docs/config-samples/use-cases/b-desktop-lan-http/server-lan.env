# ============================================================================
# ~/.zalo-agent-cli/server.env      (`--env-file`, or the service's environment)
# MCP server for AI agents on the same LAN: HTTP, token required
# ============================================================================
#   cp server-lan.env ~/.zalo-agent-cli/server.env && chmod 600 ~/.zalo-agent-cli/server.env
#   (Windows: only your user may read it)
#
# Start:  zalo-agent --env-file ~/.zalo-agent-cli/server.env mcp start --account 1000000000000000001
# (the WinSW service and the launchd agent in this folder pass the same --env-file)

# Bind to the LAN address, not 0.0.0.0, when the host has several interfaces:
ZALO_MCP_HOST=192.168.1.20
ZALO_MCP_HTTP_PORT=3847

# Required on a LAN: anyone who can reach the port can read the account's
# messages and send as it. Generate one:  openssl rand -hex 32
ZALO_MCP_AUTH_TOKEN=CHANGE_ME_64_HEX_CHARACTERS

# Optional HTTPS on the LAN (a self-signed or mkcert certificate):
# ZALO_MCP_TLS_CERT=/home/you/.zalo-agent-cli/tls/lan.crt
# ZALO_MCP_TLS_KEY=/home/you/.zalo-agent-cli/tls/lan.key

# Firewall it to the subnet as well (README step 5; Linux: ufw):
#   sudo ufw allow from 192.168.1.0/24 to any port 3847 proto tcp
