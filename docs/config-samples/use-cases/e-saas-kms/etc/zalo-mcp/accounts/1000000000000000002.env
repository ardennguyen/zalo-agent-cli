# /etc/zalo-mcp/accounts/1000000000000000002.env     account 1000000000000000002; read by zalo-mcp@1000000000000000002.service
#   sudo install -m 600 1000000000000000002.env /etc/zalo-mcp/accounts/1000000000000000002.env
# Generated by `zalo-agent fleet generate --provider kms`, then this account's tenant key added.

ZALO_MCP_HOST=127.0.0.1
ZALO_MCP_HTTP_PORT=3902
ZALO_MCP_AUTH_TOKEN=CHANGE_ME_64_HEX_CHARACTERS
# The address clients reach this account at through the proxy: the one-time pages, media and
# approval links are built from it, never from 127.0.0.1. `fleet generate --domain <host>` writes it.
ZALO_MCP_PUBLIC_URL=https://zalo.example.com/a/1000000000000000002

# Presence: on-demand (the server default) closes the Zalo socket after 5 idle minutes and opens it
# again on the next tool call, wait or CRM lease; what arrived meanwhile comes in on that reconnect
# (webhooks flagged catchUp). always-on keeps it open for real-time webhooks (the paid tier; one per
# user). The daemons follow it once on-demand presence is switched on; until then they stay connected.
# ZALO_PRESENCE_MODE=always-on

# Where this account's incoming messages are POSTed, and the secret that signs them:
# ZALO_WEBHOOK_URL=https://crm.example.com/hooks/zalo/1000000000000000002
# ZALO_WEBHOOK_SECRET=CHANGE_ME_WEBHOOK_SIGNING_SECRET

# This account's tenant key (an environment variable beats storage.json, so each account can be
# wrapped under its own tenant's KMS key; the backend and the instance's credentials come from
# storage.json and the cloud SDK's own chain). A key id, never key material.
ZALO_KMS_KEY=arn:aws:kms:ap-southeast-1:111122223333:key/22222222-2222-2222-2222-222222222222
