{
    "name": "@ardennguyen/zalo-agent-cli",
    "version": "3.0.0",
    "description": "CLI and MCP server for Zalo automation, on its own Zalo-protocol engine — multi-account, proxy, bank transfers, QR payments, Official Account API v3.0",
    "type": "module",
    "bin": {
        "zalo-agent": "src/index.js"
    },
    "main": "./src/index.js",
    "files": [
        ".env.example",
        "DISCLAIMER.md",
        "LICENSE",
        "NOTICE",
        "src/"
    ],
    "scripts": {
        "test": "node --test tests/unit/*.test.js tests/cli/*.test.js",
        "lint": "eslint --max-warnings 0 src/ tests/",
        "lint:fix": "eslint src/ tests/ --fix",
        "format": "prettier --write src/ tests/",
        "format:check": "prettier --check src/ tests/",
        "release": "echo 'Releases go through a PR into main - see docs/RELEASE.md' && exit 1",
        "prepublishOnly": "npm run lint && npm test",
        "test:unit": "node --test tests/unit/*.test.js",
        "test:cli": "node --test tests/cli/*.test.js",
        "test:e2e": "node tests/run-e2e.js",
        "test:e2e:destructive": "node tests/run-e2e.js --destructive"
    },
    "keywords": [
        "zalo",
        "cli",
        "automation",
        "messaging",
        "vietnam",
        "proxy",
        "vietqr",
        "official-account",
        "zalo-oa",
        "webhook",
        "mcp",
        "mcp-server",
        "model-context-protocol"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/ardennguyen/zalo-agent-cli"
    },
    "author": "ardennguyen",
    "license": "CC-BY-NC-SA-4.0",
    "publishConfig": {
        "access": "public"
    },
    "engines": {
        "node": ">=22.19.0"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.32.1",
        "better-sqlite3-multiple-ciphers": "13.0.3",
        "chalk": "^5.6.2",
        "commander": "^15.0.0",
        "express": "^5.2.1",
        "google-protobuf": "^3.21.4",
        "https-proxy-agent": "^9.1.0",
        "image-size": "^2.0.4",
        "qrcode-generator": "^2.0.4",
        "tough-cookie": "^5.1.2",
        "undici": "^8.5.0",
        "ws": "^8.21.3",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "acorn": "^8.19.0",
        "eslint": "^10.0.3",
        "prettier": "^3.8.1"
    },
    "peerDependencies": {
        "@aws-sdk/client-kms": "^3.0.0",
        "@azure/identity": ">=4.0.0",
        "@azure/keyvault-keys": ">=4.0.0",
        "@google-cloud/kms": ">=4.0.0"
    },
    "peerDependenciesMeta": {
        "@aws-sdk/client-kms": {
            "optional": true
        },
        "@azure/identity": {
            "optional": true
        },
        "@azure/keyvault-keys": {
            "optional": true
        },
        "@google-cloud/kms": {
            "optional": true
        }
    },
    "allowScripts": {
        "better-sqlite3-multiple-ciphers@13.0.3": false
    }
}
