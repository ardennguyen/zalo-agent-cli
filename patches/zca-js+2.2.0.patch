--- /dev/null
+++ b/node_modules/zca-js/dist/cjs/apis/logoutV2.cjs
@@ -0,0 +1,83 @@
+'use strict';
+
+var ZaloApiError = require('../Errors/ZaloApiError.cjs');
+var utils = require('../utils.cjs');
+
+// CONFIRMED live 2026-09-19 against a real account. Mirrors Zalo Web's own
+// `ServiceURL.logoutV2(imei, compId?)` (commandId 12743, POST
+// /api/v2/login/logOut), reverse-engineered from the production webpack
+// bundle:
+//   static logoutV2(e,t=void 0){
+//     const a = _.b.getDevDomainV3() + "/api/v2/login/logOut?" + this._getCommonParams();
+//     let s = { time, imei: e, computer_name, language };
+//     if (t !== void 0) s.compId = t;
+//     return this._post(a, "params=" + encodeURIComponent(encodeAES(JSON.stringify(s))), null, 12743);
+//   }
+//
+// DOMAIN — resolved by trial (each guess live-tested against a real
+// account):
+//   1. `zpwServiceMap.aext` (aextra-wpa.chat.zalo.me) — the accessor
+//      `getListDevice` uses. DISPROVEN: real HTTP 404.
+//   2. `zpwServiceMap.zavi` (wpa.zaloapp.com) — DISPROVEN: reachable, but a
+//      real API error ({error_code:102, "session key was improperly
+//      submitted..."}) — `zaloapp.com` is a different registrable domain
+//      from `zalo.me`, so the zpw_sek session cookie (scoped to `.zalo.me`)
+//      never reached it.
+//   3. `https://wpa.chat.zalo.me` (HARDCODED, not from zpwServiceMap) —
+//      CONFIRMED CORRECT, live-tested 2026-09-19. Matches `getSettings.js`
+//      in this same package (a genuinely working, authenticated,
+//      hardcoded-domain call) and the known hardcoded PRE-login host this
+//      package's `login.js` already uses. Live response:
+//      `{"error_code":0,"error_message":"Successful.","data":1}`.
+//   4. `https://stg-wpa.chat.zalo.me` — what the real production webpack
+//      bundle's `getDevDomainV3()` singleton actually returned when called
+//      live in-browser 2026-09-18 (via webpack-jsonp module-cache capture,
+//      zero real requests made). CONFIRMED CORRECT end-to-end, live-tested
+//      2026-09-19 via a real `logout --purge`: "Server session invalidated
+//      for imei e239d3d5…", no fallback warning — a real authenticated
+//      call against this domain, not just the direct-call capture. ACTIVE
+//      BELOW. Candidate #3 above is left documented as the previously-
+//      confirmed fallback in case this domain is ever retired/changed, but
+//      is no longer needed.
+//
+// ENCRYPTION — the response body above is CONFIRMED to be plain JSON, not
+// the usual AES-encrypted `data` field most zca-js API responses use.
+// `utils.resolve()` defaults to `isEncrypted = true`, which tried to
+// AES-decrypt the literal number `1` and, because crypto-js silently
+// returns an empty string on bad ciphertext/padding rather than throwing,
+// produced "Failed to parse response data: SyntaxError: Unexpected end of
+// JSON input" (from `JSON.parse("")`) even though the call had already
+// succeeded server-side. Fixed by passing `isEncrypted = false` to
+// `utils.resolve()` here so `result.data` is used as-is.
+//
+// (Earlier iterations of this file also had a real bug where
+// `utils.resolve(response)` was called without `await` — since it wraps
+// an `async function`, that returned a pending Promise instead of the
+// actual result, which silently broke a since-removed multi-candidate
+// fallback loop. Not relevant now that the domain is confirmed and this
+// is back to a single direct call, but noted here in case this file ever
+// grows a retry/fallback again: always `await utils.resolve(...)`.)
+const logoutV2Factory = utils.apiFactory()((api, ctx, utils) => {
+    const serviceURL = utils.makeURL("https://stg-wpa.chat.zalo.me/api/v2/login/logOut");
+    return async function logoutV2(compId = undefined) {
+        const params = {
+            time: Date.now(),
+            imei: ctx.imei,
+            computer_name: "Web",
+            language: ctx.language || "vi"
+        };
+        if (compId !== undefined) params.compId = compId;
+        const encryptedParams = utils.encodeAES(JSON.stringify(params));
+        if (!encryptedParams) throw new ZaloApiError.ZaloApiError("Failed to encrypt message");
+        const response = await utils.request(serviceURL, {
+            method: "POST",
+            body: new URLSearchParams({
+                params: encryptedParams,
+            }),
+        });
+        // isEncrypted = false — see the file header note above.
+        return await utils.resolve(response, undefined, false);
+    };
+});
+
+exports.logoutV2Factory = logoutV2Factory;
