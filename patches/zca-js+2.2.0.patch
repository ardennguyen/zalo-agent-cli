@@ -0,0 +1,18 @@
+import { ZaloApiError } from "../Errors/ZaloApiError.js";
+import { apiFactory } from "../utils.js";
+
+export const deleteSnapshotMobileMsgFactory = apiFactory()((api, ctx, utils) => {
+    const serviceURL = utils.makeURL(`${api.zpwServiceMap.file[0]}/api/message/delete_snapshot_mobile_msg`);
+    return async function deleteSnapshotMobileMsg(publicKey) {
+        const params = {
+            public_key: publicKey,
+            imei: ctx.imei
+        };
+        const encryptedParams = utils.encodeAES(JSON.stringify(params));
+        if (!encryptedParams) throw new ZaloApiError("Failed to encrypt message");
+        const response = await utils.request(`${serviceURL}&params=${encodeURIComponent(encryptedParams)}`, {
+            method: "GET"
+        });
+        return utils.resolve(response);
+    };
+});
