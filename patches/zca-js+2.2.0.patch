+export const requestSyncMessageFactory = apiFactory()((api, _, utils) => {
+    const serviceURL = utils.makeURL(`${api.zpwServiceMap.file[0]}/api/transfer-sync-v2/request-sync`);
+    return async function requestSyncMessage(reqId, data) {
+        const params = {
+            reqId: String(reqId),
+            data: JSON.stringify(data)
+        };
+        const encryptedParams = utils.encodeAES(JSON.stringify(params));
+        if (!encryptedParams) throw new ZaloApiError("Failed to encrypt message");
+        const response = await utils.request(`${serviceURL}&params=${encodeURIComponent(encryptedParams)}`, {
+            method: "GET"
+        });
+        return utils.resolve(response);
+    };
+});
